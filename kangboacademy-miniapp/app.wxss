/* ═══════════════════════════════════════
 康波研究院 · 全局样式
 设计语言: 深空金 · 极简 · 沉浸
 ═══════════════════════════════════════ */

page {
 --bg: #07070a;
 --bg2: #0d0d14;
 --bg3: #12121a;
 --card: #15151c;
 --card2: #1c1c24;
 --border: #2c2c38;
 --text: #f5f5f7;
 --text2: #b5b5c2;
 --text3: #7a7a88;
 --gold: #e2b64f;
 --gold-light: #f0d478;
 --gold-dark: #b8922e;
 --accent1: #e2b64f;
 --accent2: #22c55e;
 --accent3: #3b82f6;
 --accent4: #8b5cf6;
 --accent5: #f59e0b;
 --accent6: #ec4899;
 --radius: 14rpx;
 --radius-lg: 20rpx;
 --radius-xl: 24rpx;

 background-color: var(--bg);
 color: var(--text);
 font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
 font-size: 28rpx;
 line-height: 1.65;
}

/* 通用卡片 */
.card {
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: var(--radius);
 padding: 30rpx;
}

.card-gold {
 border-color: rgba(226,182,79,0.2);
 background: linear-gradient(135deg, rgba(226,182,79,0.06), var(--card));
}

/* 按钮 */
.btn {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 padding: 16rpx 40rpx;
 border-radius: 12rpx;
 font-size: 28rpx;
 font-weight: 600;
 transition: all 0.2s;
}

.btn-primary {
 background: linear-gradient(135deg, var(--gold-dark), var(--gold));
 color: #000;
}

.btn-primary:active {
 opacity: 0.85;
 transform: scale(0.97);
}

.btn-outline {
 border: 1rpx solid var(--gold);
 color: var(--gold);
 background: transparent;
}

.btn-outline:active {
 background: rgba(226,182,79,0.1);
}

.btn-ghost {
 color: var(--text2);
 background: rgba(255,255,255,0.04);
}

/* 标题 */
.section-title {
 font-size: 36rpx;
 font-weight: 700;
 color: var(--text);
 margin-bottom: 8rpx;
}

.section-heading {
 display: flex;
 align-items: center;
 gap: 14rpx;
 margin-bottom: 8rpx;
}

.section-heading .section-title {
 margin-bottom: 0;
}

.gold-mark {
 display: inline-block;
 width: 34rpx;
 height: 34rpx;
 border-radius: 10rpx;
 border: 1rpx solid rgba(226,182,79,0.34);
 background: rgba(226,182,79,0.1);
 position: relative;
 flex: 0 0 34rpx;
}

.gold-mark::after {
 content: '';
 position: absolute;
 left: 10rpx;
 top: 10rpx;
 width: 12rpx;
 height: 12rpx;
 border-radius: 50%;
 background: var(--gold);
 box-shadow: 0 0 12rpx rgba(226,182,79,0.38);
}

.gold-line-icon {
 display: inline-block;
 width: 40rpx;
 height: 40rpx;
 border-radius: 12rpx;
 border: 1rpx solid rgba(226,182,79,0.34);
 background: rgba(226,182,79,0.08);
 position: relative;
 flex: 0 0 40rpx;
}

.gold-line-icon::before,
.gold-line-icon::after {
 content: '';
 position: absolute;
 left: 11rpx;
 right: 11rpx;
 height: 3rpx;
 border-radius: 3rpx;
 background: var(--gold);
}

.gold-line-icon::before {
 top: 13rpx;
}

.gold-line-icon::after {
 top: 22rpx;
}

.section-subtitle {
 font-size: 26rpx;
 color: var(--text3);
 margin-bottom: 30rpx;
}

/* 标签 */
.tag {
 display: inline-block;
 padding: 4rpx 16rpx;
 border-radius: 8rpx;
 font-size: 22rpx;
 font-weight: 600;
}

.tag-gold { background: rgba(226,182,79,0.12); color: var(--gold); }
.tag-green { background: rgba(34,197,94,0.12); color: var(--accent2); }
.tag-blue { background: rgba(59,130,246,0.12); color: var(--accent3); }
.tag-purple { background: rgba(139,92,246,0.12); color: var(--accent4); }
.tag-orange { background: rgba(245,158,11,0.12); color: var(--accent5); }

/* 分割线 */
.divider {
 height: 1rpx;
 background: var(--border);
 margin: 30rpx 0;
}

/* 页面容器 */
.page-container {
 min-height: 100vh;
 padding-bottom: 40rpx;
}

/* 响应式 padding */
.px { padding: 0 30rpx; }

/* Flex 工具 */
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-wrap { flex-wrap: wrap; }
.gap-sm { gap: 12rpx; }
.gap-md { gap: 20rpx; }
.gap-lg { gap: 30rpx; }

/* 文本 */
.text-gold { color: var(--gold); }
.text-dim { color: var(--text2); }
.text-muted { color: var(--text3); }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 40rpx; }
.text-center { text-align: center; }
.font-bold { font-weight: 700; }

/* 安全区 */
.safe-bottom {
 padding-bottom: constant(safe-area-inset-bottom);
 padding-bottom: env(safe-area-inset-bottom);
}
