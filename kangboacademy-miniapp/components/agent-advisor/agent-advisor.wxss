.agent-panel {
 margin-top: 28rpx;
 padding: 28rpx;
 background: linear-gradient(135deg, rgba(226, 182, 79, 0.08), rgba(226, 182, 79, 0.04));
 border: 1rpx solid rgba(226, 182, 79, 0.2);
 border-radius: 18rpx;
}

.agent-head {
 display: flex;
 align-items: flex-start;
 justify-content: space-between;
 gap: 18rpx;
 margin-bottom: 14rpx;
}

.agent-title-wrap {
 flex: 1;
 min-width: 0;
}

.agent-kicker {
 display: block;
 font-size: 18rpx;
 line-height: 1;
 color: #e2b64f;
 letter-spacing: 0;
 margin-bottom: 8rpx;
}

.agent-title {
 display: block;
 font-size: 30rpx;
 line-height: 1.25;
 color: #f5f5f7;
 font-weight: 800;
}

.agent-status {
 flex-shrink: 0;
 max-width: 220rpx;
 padding: 6rpx 14rpx;
 border-radius: 999rpx;
 background: rgba(226, 182, 79, 0.12);
 color: #e2b64f;
 font-size: 22rpx;
 line-height: 1.25;
 text-align: center;
}

.agent-intro {
 display: block;
 color: #b5b5c2;
 font-size: 25rpx;
 line-height: 1.7;
 margin-bottom: 18rpx;
}

.agent-actions {
 display: flex;
 flex-direction: column;
 gap: 12rpx;
 margin-bottom: 18rpx;
}

.agent-action {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 16rpx;
 padding: 16rpx 18rpx;
 background: rgba(255, 255, 255, 0.05);
 border: 1rpx solid rgba(255, 255, 255, 0.08);
 border-radius: 12rpx;
}

.agent-action:active,
.prompt-item:active {
 background: rgba(226, 182, 79, 0.1);
}

.action-label {
 flex: 1;
 min-width: 0;
 color: #f5f5f7;
 font-size: 25rpx;
 font-weight: 700;
}

.action-ops {
 flex-shrink: 0;
 display: flex;
 align-items: center;
 gap: 12rpx;
}

.action-copy {
 flex-shrink: 0;
 color: #e2b64f;
 font-size: 23rpx;
}

.action-ask,
.prompt-ask {
 flex-shrink: 0;
 padding: 7rpx 13rpx;
 border-radius: 999rpx;
 background: rgba(226, 182, 79, 0.13);
 color: #e2b64f;
 font-size: 22rpx;
 line-height: 1.2;
}

.prompt-list {
 display: flex;
 flex-direction: column;
 gap: 14rpx;
}

.prompt-item {
 display: flex;
 align-items: flex-start;
 gap: 14rpx;
 padding: 18rpx;
 background: rgba(7, 7, 10, 0.42);
 border: 1rpx solid rgba(255, 255, 255, 0.07);
 border-radius: 14rpx;
}

.prompt-index {
 width: 34rpx;
 height: 34rpx;
 line-height: 34rpx;
 text-align: center;
 flex-shrink: 0;
 border-radius: 10rpx;
 background: rgba(226, 182, 79, 0.14);
 color: #e2b64f;
 font-size: 20rpx;
 font-weight: 800;
}

.prompt-text {
 flex: 1;
 min-width: 0;
 color: #d7d7df;
 font-size: 25rpx;
 line-height: 1.65;
}

.agent-loading,
.agent-error,
.agent-answer {
 margin-top: 18rpx;
 padding: 20rpx;
 border-radius: 14rpx;
}

.agent-loading {
 color: #e2b64f;
 background: rgba(226, 182, 79, 0.08);
 border: 1rpx solid rgba(226, 182, 79, 0.18);
 font-size: 24rpx;
}

.agent-error {
 color: #fecaca;
 background: rgba(239, 68, 68, 0.1);
 border: 1rpx solid rgba(239, 68, 68, 0.2);
 font-size: 24rpx;
 line-height: 1.55;
}

.agent-answer {
 background: rgba(255, 255, 255, 0.055);
 border: 1rpx solid rgba(226, 182, 79, 0.18);
}

.answer-title {
 display: block;
 color: #e2b64f;
 font-size: 24rpx;
 font-weight: 800;
 margin-bottom: 12rpx;
}

.answer-text {
 display: block;
 color: #f5f5f7;
 font-size: 25rpx;
 line-height: 1.72;
 white-space: pre-wrap;
}

.answer-copy {
 margin-top: 18rpx;
 padding: 14rpx 18rpx;
 text-align: center;
 color: #e2b64f;
 font-size: 24rpx;
 border: 1rpx solid rgba(226, 182, 79, 0.22);
 border-radius: 12rpx;
 background: rgba(226, 182, 79, 0.08);
}
