.graph-header { padding-top: 30rpx; margin-bottom: 30rpx; }

.kg-grid { display: flex; flex-direction: column; gap: 24rpx; }

.kg-group {
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: var(--radius-lg);
 overflow: hidden;
}

.kg-group-header {
 display: flex;
 align-items: center;
 justify-content: space-between;
 padding: 20rpx 24rpx;
 border-bottom: 2rpx solid rgba(226,182,79,0.2);
 background: var(--bg2);
}

.kg-group-title {
 display: flex;
 align-items: center;
 gap: 12rpx;
 min-width: 0;
}

.kg-group-mark {
 width: 28rpx;
 height: 28rpx;
 border-radius: 9rpx;
 border: 1rpx solid rgba(226,182,79,0.34);
 background: rgba(226,182,79,0.1);
 position: relative;
 flex-shrink: 0;
}

.kg-group-mark::after {
 content: '';
 position: absolute;
 left: 9rpx;
 top: 9rpx;
 width: 10rpx;
 height: 10rpx;
 border-radius: 50%;
 background: var(--gold);
}

.kg-group-name { font-size: 28rpx; font-weight: 700; color: var(--gold); }
.kg-group-count { font-size: 22rpx; color: var(--gold); background: rgba(226,182,79,0.08); padding: 4rpx 14rpx; border-radius: 8rpx; }

.kg-nodes { padding: 12rpx; }

.kg-node {
 display: flex;
 align-items: center;
 padding: 16rpx 12rpx;
 gap: 14rpx;
 border-radius: 10rpx;
}

.kg-node:active { background: var(--bg2); }

.kg-node-dot {
 width: 12rpx;
 height: 12rpx;
 border-radius: 50%;
 background: var(--gold);
 flex-shrink: 0;
}

.kg-node-info { flex: 1; min-width: 0; }
.kg-node-name { font-size: 26rpx; font-weight: 600; color: var(--text); display: block; }
.kg-node-desc { font-size: 22rpx; color: var(--text3); display: block; margin-top: 2rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.kg-stats {
 display: flex;
 justify-content: space-around;
 padding: 40rpx 0;
 margin-top: 30rpx;
 border-top: 1rpx solid var(--border);
}

.stat-card { text-align: center; }
