/* 课程列表 */

.search-bar {
 position: relative;
 margin: 20rpx 0;
}

.search-input {
 width: 100%;
 height: 80rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: 16rpx;
 padding: 0 60rpx 0 40rpx;
 color: var(--text);
 font-size: 28rpx;
}

.search-input:focus {
 border-color: var(--gold);
}

.search-icon, .search-clear {
 position: absolute;
 right: 30rpx;
 top: 50%;
 transform: translateY(-50%);
 color: var(--text3);
}

.search-icon {
 width: 28rpx;
 height: 28rpx;
 border: 3rpx solid var(--gold);
 border-radius: 50%;
 box-sizing: border-box;
}

.search-icon::after {
 content: '';
 position: absolute;
 right: -8rpx;
 bottom: -4rpx;
 width: 12rpx;
 height: 3rpx;
 border-radius: 3rpx;
 background: var(--gold);
 transform: rotate(45deg);
}

.search-clear {
 font-size: 28rpx;
}

.stats-bar {
 padding: 16rpx 0;
 margin-bottom: 16rpx;
}

/* 阶段标题 */
.phase-header {
 display: flex;
 align-items: center;
 padding: 30rpx 30rpx 20rpx;
 gap: 16rpx;
}

.phase-icon {
 width: 34rpx;
 height: 34rpx;
 border-radius: 10rpx;
 border: 1rpx solid rgba(226,182,79,0.34);
 background: rgba(226,182,79,0.1);
 position: relative;
 flex-shrink: 0;
}

.phase-icon::after {
 content: '';
 position: absolute;
 left: 10rpx;
 top: 10rpx;
 width: 12rpx;
 height: 12rpx;
 border-radius: 50%;
 background: var(--gold);
}
.phase-info { flex: 1; }
.phase-title { font-size: 30rpx; font-weight: 700; color: var(--text); display: block; }
.phase-sub { font-size: 24rpx; color: var(--text3); display: block; margin-top: 2rpx; }
.phase-num { font-size: 22rpx; color: var(--gold); background: rgba(226,182,79,0.08); padding: 4rpx 14rpx; border-radius: 8rpx; }

/* 课程列表 */
.course-list {
 display: flex;
 flex-direction: column;
 gap: 12rpx;
 margin-bottom: 20rpx;
}
