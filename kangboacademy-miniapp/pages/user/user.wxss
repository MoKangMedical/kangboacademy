/* 用户页 */

.user-hero {
 padding: 60rpx 30rpx 40rpx;
 text-align: center;
 background: linear-gradient(180deg, rgba(226,182,79,0.04), transparent);
}

.user-avatar, .user-avatar-placeholder {
 width: 120rpx;
 height: 120rpx;
 border-radius: 50%;
 margin: 0 auto 20rpx;
 overflow: hidden;
 border: 2rpx solid rgba(226,182,79,0.3);
}

.user-avatar-placeholder {
 background: rgba(226,182,79,0.08);
 display: flex;
 align-items: center;
 justify-content: center;
}

.avatar-icon {
 width: 52rpx;
 height: 52rpx;
 border-radius: 50%;
 border: 2rpx solid var(--gold);
 position: relative;
}

.avatar-icon::before {
 content: '';
 position: absolute;
 left: 16rpx;
 top: 10rpx;
 width: 16rpx;
 height: 16rpx;
 border-radius: 50%;
 background: var(--gold);
}

.avatar-icon::after {
 content: '';
 position: absolute;
 left: 10rpx;
 bottom: 9rpx;
 width: 28rpx;
 height: 14rpx;
 border-radius: 16rpx 16rpx 6rpx 6rpx;
 background: var(--gold);
}
.avatar-img { width: 100%; height: 100%; }

.user-name {
 font-size: 36rpx;
 font-weight: 700;
 color: var(--text);
 display: block;
 margin-bottom: 6rpx;
}

.user-desc {
 font-size: 24rpx;
 color: var(--text3);
 display: block;
}

/* 统计 */
.stats-row {
 display: flex;
 justify-content: space-around;
 padding: 20rpx 0 30rpx;
}

/* 每日精进 */
.refinement-section {
 margin-bottom: 18rpx;
}

.refinement-card {
 padding: 26rpx 24rpx;
 background: var(--card);
 border: 1rpx solid rgba(226,182,79,0.22);
 border-radius: var(--radius);
}

.refinement-head {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 18rpx;
 margin-bottom: 22rpx;
}

.refinement-title {
 display: block;
 color: var(--text);
 font-size: 30rpx;
 font-weight: 800;
}

.refinement-sub {
 display: block;
 margin-top: 4rpx;
 color: var(--text3);
 font-size: 22rpx;
}

.streak-pill {
 min-width: 80rpx;
 height: 52rpx;
 padding: 0 16rpx;
 border-radius: 10rpx;
 background: rgba(226,182,79,0.1);
 color: var(--gold);
 font-size: 24rpx;
 font-weight: 800;
 line-height: 52rpx;
 text-align: center;
}

.refinement-stats {
 display: flex;
 justify-content: space-between;
 gap: 14rpx;
}

.refinement-stat {
 flex: 1;
 min-width: 0;
 text-align: center;
 padding: 18rpx 8rpx;
 border-radius: 10rpx;
 background: var(--bg2);
}

.refinement-num {
 display: block;
 color: var(--gold);
 font-size: 34rpx;
 font-weight: 900;
 line-height: 1.1;
}

.refinement-label {
 display: block;
 margin-top: 6rpx;
 color: var(--text3);
 font-size: 21rpx;
}

.recent-badges {
 display: flex;
 flex-wrap: wrap;
 gap: 12rpx;
 margin-top: 18rpx;
}

.recent-badge {
 display: inline-flex;
 align-items: center;
 gap: 8rpx;
 max-width: 100%;
 padding: 8rpx 12rpx;
 border-radius: 8rpx;
 background: rgba(255,255,255,0.05);
}

.recent-badge-icon {
 width: 20rpx;
 height: 20rpx;
 border-radius: 6rpx;
 background: var(--gold);
 box-shadow: 0 0 10rpx rgba(226,182,79,0.35);
 flex-shrink: 0;
}

.recent-badge-name {
 color: var(--text2);
 font-size: 22rpx;
}

/* 微信账号与手机号 */
.profile-section {
 margin-bottom: 18rpx;
}

.profile-card {
 padding: 26rpx 24rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: var(--radius);
}

.profile-row {
 display: flex;
 align-items: center;
 justify-content: space-between;
 min-height: 70rpx;
 border-bottom: 1rpx solid var(--border);
}

.profile-label {
 flex: 0 0 auto;
 font-size: 26rpx;
 color: var(--text2);
}

.profile-value {
 font-size: 26rpx;
 color: var(--gold);
 font-weight: 700;
}

.phone-row {
 gap: 18rpx;
 padding: 12rpx 0;
}

.phone-input {
 flex: 1;
 min-width: 0;
 height: 64rpx;
 padding: 0 18rpx;
 background: var(--bg2);
 border: 1rpx solid var(--border);
 border-radius: 10rpx;
 color: var(--text);
 font-size: 26rpx;
}

.save-phone {
 flex: 0 0 auto;
 min-width: 88rpx;
 height: 64rpx;
 padding: 0 18rpx;
 border-radius: 10rpx;
 background: var(--gold);
 color: #08080a;
 font-size: 25rpx;
 font-weight: 700;
 line-height: 64rpx;
 text-align: center;
}

.save-phone.disabled {
 opacity: 0.55;
}

.wechat-phone-btn {
 width: 100%;
 height: 72rpx;
 margin: 22rpx 0 12rpx;
 padding: 0;
 border: 1rpx solid rgba(226,182,79,0.35);
 border-radius: 10rpx;
 background: rgba(226,182,79,0.08);
 color: var(--gold);
 font-size: 26rpx;
 font-weight: 700;
 line-height: 72rpx;
}

.wechat-phone-btn::after {
 border: 0;
}

.profile-hint {
 display: block;
 color: var(--text3);
 font-size: 22rpx;
 line-height: 1.5;
}

/* 菜单 */
.menu-section {
 background: var(--card);
 border-radius: var(--radius);
 border: 1rpx solid var(--border);
 overflow: hidden;
}

.menu-item {
 display: flex;
 align-items: center;
 justify-content: space-between;
 padding: 28rpx 24rpx;
 border-bottom: 1rpx solid var(--border);
 font-size: 28rpx;
 color: var(--text);
}

.menu-label {
 display: flex;
 align-items: center;
 gap: 16rpx;
 min-width: 0;
}

.menu-icon {
 width: 34rpx;
 height: 34rpx;
 border-radius: 10rpx;
}

.menu-icon::before {
 top: 11rpx;
}

.menu-icon::after {
 top: 20rpx;
}

.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: var(--bg2); }

.menu-arrow {
 font-size: 36rpx;
 color: var(--text3);
}

.version-info {
 display: flex;
 flex-direction: column;
 gap: 4rpx;
 padding: 60rpx 0;
}
