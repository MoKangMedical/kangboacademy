.member-hero {
 padding-top: 42rpx;
 padding-bottom: 24rpx;
}

.member-title {
 display: block;
 color: var(--text);
 font-size: 44rpx;
 font-weight: 800;
 line-height: 1.2;
}

.member-subtitle {
 display: block;
 color: var(--text2);
 font-size: 26rpx;
 line-height: 1.6;
 margin-top: 12rpx;
}

.mode-grid {
 display: flex;
 gap: 16rpx;
 margin: 10rpx 0 24rpx;
}

.mode-card {
 flex: 1;
 display: flex;
 gap: 14rpx;
 align-items: flex-start;
 min-height: 132rpx;
 padding: 22rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: var(--radius);
}

.mode-icon {
 width: 38rpx;
 height: 38rpx;
}

.mode-body {
 min-width: 0;
}

.mode-title {
 display: block;
 color: var(--text);
 font-size: 26rpx;
 font-weight: 700;
}

.mode-desc {
 display: block;
 color: var(--text3);
 font-size: 22rpx;
 line-height: 1.45;
 margin-top: 6rpx;
}

.purchase-section {
 margin-bottom: 24rpx;
}

.purchase-card {
 padding: 26rpx 24rpx;
 background: var(--card);
 border: 1rpx solid rgba(226,182,79,0.22);
 border-radius: var(--radius);
}

.purchase-head {
 display: flex;
 justify-content: space-between;
 align-items: flex-start;
 gap: 18rpx;
 margin-bottom: 18rpx;
}

.purchase-title {
 display: block;
 color: var(--text);
 font-size: 30rpx;
 font-weight: 800;
 line-height: 1.25;
}

.purchase-sub {
 display: block;
 color: var(--text3);
 font-size: 22rpx;
 margin-top: 6rpx;
}

.refresh-link {
 flex-shrink: 0;
 padding: 8rpx 16rpx;
 border-radius: 8rpx;
 color: var(--gold);
 background: rgba(226,182,79,0.08);
 font-size: 23rpx;
 font-weight: 700;
}

.purchase-error {
 margin-bottom: 16rpx;
 padding: 16rpx;
 border-radius: 10rpx;
 color: var(--gold);
 background: rgba(226,182,79,0.08);
 font-size: 23rpx;
 line-height: 1.5;
}

.purchase-list {
 display: flex;
 flex-direction: column;
 gap: 14rpx;
}

.purchase-loading {
 padding: 34rpx 0;
 text-align: center;
}

.purchase-item {
 display: flex;
 gap: 16rpx;
 padding: 18rpx;
 border-radius: 12rpx;
 background: var(--bg2);
}

.purchase-cover {
 width: 72rpx;
 height: 90rpx;
 flex-shrink: 0;
 display: flex;
 align-items: center;
 justify-content: center;
 border-radius: 10rpx;
 background: rgba(226,182,79,0.06);
}

.book-cover-mark {
 width: 42rpx;
 height: 54rpx;
 border-radius: 8rpx 12rpx 12rpx 8rpx;
 border: 2rpx solid rgba(226,182,79,0.52);
 background: rgba(226,182,79,0.08);
 position: relative;
}

.book-cover-mark::before {
 content: '';
 position: absolute;
 left: 9rpx;
 top: 9rpx;
 bottom: 9rpx;
 width: 3rpx;
 border-radius: 3rpx;
 background: var(--gold);
}

.book-cover-mark::after {
 content: '';
 position: absolute;
 left: 18rpx;
 right: 8rpx;
 top: 15rpx;
 height: 3rpx;
 border-radius: 3rpx;
 background: var(--gold);
 box-shadow: 0 12rpx 0 rgba(226,182,79,0.72);
}

.purchase-body {
 flex: 1;
 min-width: 0;
}

.purchase-line {
 display: flex;
 align-items: flex-start;
 gap: 12rpx;
}

.purchase-name {
 flex: 1;
 min-width: 0;
 color: var(--text);
 font-size: 26rpx;
 font-weight: 800;
 line-height: 1.35;
}

.purchase-status {
 flex-shrink: 0;
 padding: 4rpx 12rpx;
 border-radius: 8rpx;
 font-size: 21rpx;
 font-weight: 700;
}

.purchase-status.paid {
 color: #07070a;
 background: var(--gold);
}

.purchase-status.pending {
 color: var(--gold);
 background: rgba(226,182,79,0.12);
}

.purchase-meta,
.purchase-time,
.purchase-order {
 display: block;
 color: var(--text3);
 font-size: 22rpx;
 line-height: 1.45;
 margin-top: 5rpx;
}

.purchase-empty {
 display: flex;
 flex-direction: column;
 align-items: center;
 padding: 34rpx 20rpx 14rpx;
 text-align: center;
}

.empty-title {
 color: var(--text);
 font-size: 28rpx;
 font-weight: 800;
}

.empty-desc {
 color: var(--text3);
 font-size: 23rpx;
 line-height: 1.55;
 margin: 10rpx 0 20rpx;
}

.empty-btn {
 width: 100%;
}

.payment-state {
 margin-bottom: 18rpx;
}

.payment-state {
 padding-top: 20rpx;
 padding-bottom: 20rpx;
 background: rgba(245,158,11,0.08);
 border-top: 1rpx solid rgba(245,158,11,0.18);
 border-bottom: 1rpx solid rgba(245,158,11,0.18);
}

.state-title {
 display: block;
 color: var(--accent5);
 font-size: 26rpx;
 font-weight: 700;
}

.state-desc {
 display: block;
 color: var(--text2);
 font-size: 23rpx;
 line-height: 1.5;
 margin-top: 6rpx;
}

.plans {
 display: flex;
 flex-direction: column;
 gap: 18rpx;
}

.plan-card {
 padding: 28rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: var(--radius);
}

.plan-hot {
 border-color: rgba(226,182,79,0.42);
 background: linear-gradient(135deg, rgba(226,182,79,0.08), var(--card));
}

.plan-head {
 display: flex;
 align-items: flex-start;
 justify-content: space-between;
 gap: 16rpx;
}

.plan-name {
 display: block;
 color: var(--text);
 font-size: 32rpx;
 font-weight: 800;
}

.plan-scope {
 display: block;
 color: var(--text3);
 font-size: 23rpx;
 margin-top: 4rpx;
}

.plan-badge {
 flex-shrink: 0;
 padding: 6rpx 14rpx;
 color: #000;
 background: var(--gold);
 border-radius: 8rpx;
 font-size: 22rpx;
 font-weight: 700;
}

.plan-price {
 color: var(--gold);
 font-size: 46rpx;
 font-weight: 900;
 margin: 22rpx 0 10rpx;
}

.feature-list {
 display: flex;
 flex-direction: column;
 gap: 8rpx;
 margin-bottom: 24rpx;
}

.feature {
 color: var(--text2);
 font-size: 25rpx;
 line-height: 1.45;
}

.plan-btn {
 width: 100%;
 box-sizing: border-box;
}

.plan-btn + .plan-btn {
 margin-top: 14rpx;
}

.plans + .plans {
 margin-top: 18rpx;
}

.loading-wrap {
 display: flex;
 justify-content: center;
 padding: 90rpx 0;
}
