.section { padding-top: 30rpx; }

.asset-select {
 margin: 20rpx 0 30rpx;
}

.ps-label {
 font-size: 26rpx;
 color: var(--text2);
 display: block;
 margin-bottom: 16rpx;
}

.ps-grid {
 display: flex;
 flex-wrap: wrap;
 gap: 16rpx;
}

.ps-item {
 display: flex;
 align-items: center;
 gap: 10rpx;
 padding: 18rpx 24rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: 14rpx;
 font-size: 27rpx;
 color: var(--text2);
}

.asset-mark {
 width: 18rpx;
 height: 18rpx;
 border-radius: 6rpx;
 background: var(--gold);
 flex-shrink: 0;
}

.ps-item.active {
 background: rgba(226,182,79,0.1);
 border-color: var(--gold);
 color: var(--gold);
 font-weight: 700;
}

.result-section {
 margin-top: 26rpx;
}

.result-label {
 display: block;
 color: var(--text);
 font-size: 30rpx;
 font-weight: 800;
 margin-bottom: 8rpx;
}

.result-desc {
 display: block;
 color: var(--text2);
}

.dim-item { margin-bottom: 24rpx; }
.dim-item {
 padding: 14rpx;
 border: 1rpx solid transparent;
 border-radius: 12rpx;
}
.dim-item.active {
 border-color: rgba(226,182,79,0.45);
 background: rgba(226,182,79,0.07);
}
.dim-track { height: 10rpx; background: var(--bg2); border-radius: 5rpx; margin: 8rpx 0; overflow: hidden; }
.dim-fill { height: 100%; border-radius: 5rpx; transition: width 0.5s; }
.dim-header {
 font-size: 26rpx;
 color: var(--text);
}
.analysis-text { padding: 20rpx; background: var(--bg2); border-radius: 12rpx; }

.goal-grid {
 display: grid;
 grid-template-columns: repeat(4, minmax(0, 1fr));
 gap: 12rpx;
}

.goal-item {
 min-width: 0;
 padding: 14rpx 8rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: 12rpx;
 text-align: center;
}

.goal-item.active {
 border-color: rgba(226,182,79,0.48);
 background: rgba(226,182,79,0.1);
}

.goal-name {
 display: block;
 color: var(--text);
 font-size: 25rpx;
 font-weight: 800;
}

.goal-desc {
 display: block;
 color: var(--text3);
 font-size: 20rpx;
 line-height: 1.35;
 margin-top: 4rpx;
}

.course-chips {
 display: flex;
 flex-wrap: wrap;
 gap: 12rpx;
 margin-top: 16rpx;
}

.chip {
 padding: 12rpx 20rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: 10rpx;
 display: flex;
 align-items: center;
 gap: 8rpx;
}

.chip-num {
 color: var(--gold);
 font-size: 22rpx;
 font-weight: 800;
}

.chip-name {
 color: var(--text);
 font-size: 24rpx;
}
