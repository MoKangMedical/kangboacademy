.section { padding-top: 30rpx; }

.scenario-panel {
 padding: 26rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: var(--radius-lg);
}

.panel-label {
 display: block;
 font-size: 26rpx;
 color: var(--text2);
 margin-bottom: 16rpx;
}

.scenario-grid {
 display: flex;
 flex-wrap: wrap;
 gap: 12rpx;
}

.scenario-chip {
 padding: 14rpx 20rpx;
 border-radius: 12rpx;
 background: var(--bg2);
 border: 1rpx solid var(--border);
 color: var(--text2);
 font-size: 25rpx;
}

.scenario-chip.active {
 color: var(--gold);
 border-color: rgba(226,182,79,0.45);
 background: rgba(226,182,79,0.1);
 font-weight: 700;
}

.step-flow {
 display: flex;
 flex-direction: column;
 gap: 12rpx;
 margin-top: 22rpx;
}

.step-item {
 display: flex;
 align-items: center;
 gap: 12rpx;
 color: var(--text2);
 font-size: 25rpx;
}

.step-num {
 width: 34rpx;
 height: 34rpx;
 line-height: 34rpx;
 text-align: center;
 border-radius: 10rpx;
 background: rgba(226,182,79,0.14);
 color: var(--gold);
 font-size: 20rpx;
 font-weight: 800;
}

.tool-list {
 display: flex;
 flex-direction: column;
 gap: 16rpx;
 margin-top: 28rpx;
}

.tool-item {
 display: flex;
 align-items: center;
 padding: 28rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: var(--radius);
 gap: 20rpx;
}

.tool-item:active {
 border-color: var(--gold);
 background: var(--card2);
}

.ti-icon { flex-shrink: 0; }
.ti-body { flex: 1; min-width: 0; }
.ti-top {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 14rpx;
 margin-bottom: 6rpx;
}
.ti-name { font-size: 30rpx; font-weight: 600; color: var(--text); display: block; }
.ti-desc { font-size: 24rpx; color: var(--text3); display: block; }
.ti-arrow { font-size: 40rpx; color: var(--text3); flex-shrink: 0; }
.tool-tag {
 flex-shrink: 0;
 padding: 4rpx 12rpx;
 border-radius: 8rpx;
 background: rgba(226,182,79,0.1);
 color: var(--gold);
 font-size: 21rpx;
}
