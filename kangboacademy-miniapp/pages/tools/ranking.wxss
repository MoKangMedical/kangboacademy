.section { padding-top: 30rpx; }

.ranking-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 10rpx; }

.mode-panel {
 padding: 24rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: var(--radius-lg);
 margin-bottom: 24rpx;
}

.mode-label {
 display: block;
 font-size: 26rpx;
 color: var(--text2);
 margin-bottom: 16rpx;
}

.mode-grid {
 display: grid;
 grid-template-columns: repeat(4, minmax(0, 1fr));
 gap: 12rpx;
}

.mode-item {
 min-width: 0;
 padding: 14rpx 8rpx;
 background: var(--bg2);
 border: 1rpx solid var(--border);
 border-radius: 12rpx;
 text-align: center;
}

.mode-item.active {
 border-color: rgba(226,182,79,0.48);
 background: rgba(226,182,79,0.1);
}

.mode-name {
 display: block;
 color: var(--text);
 font-size: 25rpx;
 font-weight: 800;
}

.mode-desc {
 display: block;
 color: var(--text3);
 font-size: 20rpx;
 line-height: 1.35;
 margin-top: 4rpx;
}

.rank-item {
 display: flex;
 align-items: flex-start;
 padding: 20rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: var(--radius);
 gap: 16rpx;
}

.rank-item.selected {
 border-color: rgba(226,182,79,0.45);
 background: rgba(226,182,79,0.07);
}

.rank-num {
 width: 56rpx;
 height: 56rpx;
 border-radius: 14rpx;
 font-size: 28rpx;
 font-weight: 900;
 display: flex;
 align-items: center;
 justify-content: center;
 flex-shrink: 0;
 background: var(--bg2);
 color: var(--text3);
}

.rank-1 .rank-num { background: rgba(226,182,79,0.15); color: var(--gold); border: 1rpx solid rgba(226,182,79,0.3); }
.rank-2 .rank-num { background: rgba(192,192,192,0.1); color: #c0c0c0; }
.rank-3 .rank-num { background: rgba(205,127,50,0.1); color: #cd853f; }

.rank-body { flex: 1; }
.rank-name {
 display: flex;
 align-items: center;
 gap: 10rpx;
 min-width: 0;
 font-size: 28rpx;
 font-weight: 600;
 color: var(--text);
}

.asset-mark {
 width: 18rpx;
 height: 18rpx;
 border-radius: 6rpx;
 background: var(--gold);
 flex-shrink: 0;
}
.rank-score { font-size: 28rpx; }

.rank-bar-track { height: 6rpx; background: var(--bg2); border-radius: 3rpx; margin: 8rpx 0; }
.rank-bar-fill { height: 100%; border-radius: 3rpx; }

.selected-card {
 margin-top: 22rpx;
 padding: 20rpx;
 border-radius: 12rpx;
 background: rgba(226,182,79,0.07);
 border: 1rpx solid rgba(226,182,79,0.18);
}

.selected-title {
 display: block;
 color: var(--text);
 font-size: 27rpx;
 font-weight: 800;
 margin-bottom: 4rpx;
}

.selected-desc {
 display: block;
 color: var(--text3);
 font-size: 24rpx;
 line-height: 1.6;
}

.course-chips {
 display: flex;
 flex-wrap: wrap;
 gap: 12rpx;
 margin-top: 16rpx;
}

.chip {
 padding: 12rpx 20rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: 10rpx;
 display: flex;
 align-items: center;
 gap: 8rpx;
}

.chip-num {
 color: var(--gold);
 font-size: 22rpx;
 font-weight: 800;
}

.chip-name {
 color: var(--text);
 font-size: 24rpx;
}
