.section { padding-top: 30rpx; }

.phase-selector { margin: 20rpx 0 30rpx; }
.ps-label { font-size: 26rpx; color: var(--text2); display: block; margin-bottom: 16rpx; }
.ps-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }

.ps-item {
 display: flex;
 align-items: center;
 gap: 10rpx;
 padding: 20rpx 30rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: 14rpx;
 font-size: 28rpx;
 color: var(--text2);
}

.ps-mark,
.asset-mark {
 width: 18rpx;
 height: 18rpx;
 border-radius: 6rpx;
 background: var(--gold);
 flex-shrink: 0;
}

.ps-item.active {
 background: rgba(226,182,79,0.1);
 border-color: var(--gold);
 color: var(--gold);
 font-weight: 600;
}

.horizon-grid {
 display: grid;
 grid-template-columns: repeat(3, minmax(0, 1fr));
 gap: 12rpx;
}

.horizon-item {
 min-width: 0;
 padding: 16rpx 12rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: 14rpx;
}

.horizon-item.active {
 background: rgba(226,182,79,0.1);
 border-color: rgba(226,182,79,0.48);
}

.horizon-name {
 display: block;
 color: var(--text);
 font-size: 26rpx;
 font-weight: 800;
}

.horizon-desc {
 display: block;
 color: var(--text3);
 font-size: 21rpx;
 line-height: 1.45;
 margin-top: 4rpx;
}

.result-phase { font-size: 36rpx; font-weight: 700; color: var(--gold); display: block; margin-bottom: 8rpx; }

.asset-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 16rpx; }

.asset-item {
 padding: 20rpx;
 background: var(--bg2);
 border: 1rpx solid transparent;
 border-radius: 12rpx;
}

.asset-item.selected {
 border-color: rgba(226,182,79,0.5);
 background: rgba(226,182,79,0.08);
}

.ai-name {
 display: flex;
 align-items: center;
 gap: 10rpx;
 min-width: 0;
 font-size: 28rpx;
 color: var(--text);
}
.ai-score { font-size: 28rpx; font-weight: 700; }
.ai-bar-track { height: 8rpx; background: var(--bg); border-radius: 4rpx; margin: 10rpx 0; overflow: hidden; }
.ai-bar-fill { height: 100%; border-radius: 4rpx; transition: width 0.5s; }
.ai-reason { margin-top: 4rpx; }

.focus-card {
 margin-top: 20rpx;
 padding: 20rpx;
 background: rgba(226,182,79,0.07);
 border: 1rpx solid rgba(226,182,79,0.18);
 border-radius: 12rpx;
}

.focus-title {
 display: block;
 color: var(--text);
 font-size: 27rpx;
 font-weight: 800;
 margin-bottom: 4rpx;
}

.focus-desc {
 display: block;
 color: var(--text3);
 font-size: 24rpx;
 line-height: 1.6;
}

.course-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.chip {
 padding: 12rpx 20rpx;
 background: var(--card);
 border: 1rpx solid var(--border);
 border-radius: 10rpx;
 display: flex;
 align-items: center;
 gap: 8rpx;
}
.chip-num { color: var(--gold); font-size: 22rpx; font-weight: 700; }
.chip-name { color: var(--text); font-size: 24rpx; }
